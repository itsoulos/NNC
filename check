#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'HELP'
Usage: ./check DATASET [RESULTS_DIR]
       ./check DATASET --dir RESULTS_DIR

Examples:
  ./check wine
  ./check wine results/phase3/g500_p500_f10
  ./check wine --dir results/phase3

Default results root: results/phase3 (override with NNC_RESULTS_DIR).
Requires report_logs.py in the same directory as this script.
HELP
}
if [[ ${1:-} == '-h' || ${1:-} == '--help' ]]; then usage; exit 0; fi
if [[ $# -lt 1 || $# -gt 3 ]]; then usage >&2; exit 2; fi
dataset=$1
root=${NNC_RESULTS_DIR:-results/phase3}
if [[ $# -ge 2 ]]; then
  if [[ $2 == '--dir' ]]; then
    [[ $# -eq 3 ]] || { usage >&2; exit 2; }
    root=$3
  elif [[ $# -eq 2 ]]; then
    root=$2
  else
    usage >&2; exit 2
  fi
fi
script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
[[ -f "$script_dir/report_logs.py" ]] || { echo "Missing: $script_dir/report_logs.py" >&2; exit 1; }
[[ -d "$root" ]] || { echo "Results folder not found: $root" >&2; exit 1; }

python3 - "$dataset" "$root" "$script_dir/report_logs.py" <<'PY'
import csv, pathlib, subprocess, sys, tempfile

dataset, root, reporter = sys.argv[1:]
root = pathlib.Path(root)
# Prefer enriched files; use only one file per experiment folder.
inputs=[]
for directory in [root] + sorted((p for p in root.rglob('*') if p.is_dir()), key=str):
    for name in ('results_extended.tsv','results.tsv'):
        f=directory/name
        if f.is_file():
            inputs.append(f)
            break
if not inputs:
    sys.exit(f'No results.tsv or results_extended.tsv found under {root}')
# Do not mix different generation/population/fold experiment folders.
# If a parent directory was supplied, select the most recently modified experiment.
if len(inputs)>1:
    chosen=max(inputs,key=lambda p:p.stat().st_mtime)
    print(f'Multiple experiment folders found ({len(inputs)}); using newest: {chosen}')
    print('To select another experiment, pass its folder as the second argument.')
    inputs=[chosen]

rows=[]
fields=[]
for file in inputs:
    with file.open(newline='', encoding='utf-8-sig') as handle:
        reader=csv.DictReader(handle, delimiter='\t')
        if not reader.fieldnames or 'dataset' not in reader.fieldnames:
            print(f'Ignoring invalid TSV: {file}', file=sys.stderr)
            continue
        matching=[r for r in reader if r.get('dataset')==dataset]
        if matching:
            print(f'Reading {len(matching)} rows from {file}')
            rows.extend(matching)
            fields.extend(x for x in reader.fieldnames if x not in fields)
if not rows:
    sys.exit(f'No records found for dataset {dataset!r} under {root}')

# Keep dataset-specific reports separate from original results and from other datasets.
out=root / 'checks' / dataset
out.mkdir(parents=True, exist_ok=True)
with tempfile.TemporaryDirectory(prefix='nnc_check_') as tmp:
    filtered=pathlib.Path(tmp)/'results_filtered.tsv'
    with filtered.open('w',newline='',encoding='utf-8') as handle:
        writer=csv.DictWriter(handle,fieldnames=fields,delimiter='\t',extrasaction='ignore')
        writer.writeheader()
        writer.writerows(rows)
    subprocess.run([sys.executable,reporter,str(filtered),'--out',str(out)],check=True)

summary=out/'report_summary.tsv'
with summary.open(newline='',encoding='utf-8') as handle:
    result=list(csv.DictReader(handle,delimiter='\t'))

print(f'\nDataset: {dataset} | Report: {summary}')
metrics=['test_accuracy','test_macro_precision','test_macro_recall','test_macro_f1','test_mcc']
print(f'{"Fitness":<18} {"Runs":>5} ' + ' '.join(f'{m.replace("test_", ""):>18}' for m in metrics))
for r in sorted(result,key=lambda x: -float(x.get('test_macro_f1_mean') or 0)):
    cells=[]
    for m in metrics:
        try:
            mean=float(r[f'{m}_mean']); std=float(r[f'{m}_std'])
            cells.append(f'{mean:.4f}±{std:.4f}'.rjust(18))
        except (KeyError,ValueError,TypeError):
            cells.append('n/a'.rjust(18))
    print(f'{r["fitness"]:<18} {r["n_runs"]:>5} '+' '.join(cells))
print(f'\nFull reports: {out}')
PY
